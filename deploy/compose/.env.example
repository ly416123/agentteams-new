WORKER_5_MODEL_PROXY_TOKEN_FILE=./secrets/worker-5.model-proxy-token
WORKER_6_MODEL_PROXY_TOKEN_FILE=./secrets/worker-6.model-proxy-token
WORKER_7_MODEL_PROXY_TOKEN_FILE=./secrets/worker-7.model-proxy-token
WORKER_8_MODEL_PROXY_TOKEN_FILE=./secrets/worker-8.model-proxy-token
