AGENTTEAMS_STORAGE_ENABLED=false
OBJECT_STORE_ACCESS_KEY=agentteams-storage
OBJECT_STORE_SECRET_KEY=replace-with-a-32-character-object-store-secret

# The checked-in example file is empty; replace this path with your provider token file before starting workers.
MODEL_TOKEN_FILE=./model-token.example
