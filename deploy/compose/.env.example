# Published from agentteams-java v0.1.5, source commit 0156f2c1fecdc868cb4a0f4f13fb068bb4162834.
CONTROL_PLANE_IMAGE=ghcr.io/ly416123/agentteams-control-plane@sha256:403c3da94d436c19ce09e2d347f9e4182fb972a41adc5995c57694922fb94173
# Set true whenever Workers are enabled or deployment mode is self-hosted-small.
CONTROL_PLANE_BUILD_FROM_SOURCE=false
GATEWAY_IMAGE=ghcr.io/ly416123/agentteams-agent-gateway@sha256:40c919d31b0fe7bdf876237c36fff405a16c2208420ad42374f6dd67491e055f
WORKER_BUILD_FROM_SOURCE=false
WORKER_IMAGE=ghcr.io/ly416123/agentteams-agent-worker@sha256:0aec65e942a9ecfa726032e560066d91266905dc878fd4a610d533db0118b86d

# Generate a unique value for each environment. Do not commit the real .env file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
CONTROL_PLANE_DB_PASSWORD=replace-with-a-unique-control-plane-db-password
CONTROL_PLANE_PORT=8080
ENROLLMENT_PORT=8090
# local-dev permits unauthenticated APIs only with WORKER_REPLICAS=0. Use self-hosted-small for multi-tenant deployments.
DEPLOYMENT_MODE=local-dev
API_AUTH_ENABLED=false
OIDC_ISSUER_URI=https://identity.example.invalid/issuer
OIDC_JWK_SET_URI=https://identity.example.invalid/issuer/keys
OIDC_AUDIENCE=agentteams-api
OIDC_TENANT_CLAIM=tenant
OIDC_PROJECT_CLAIM=project
OIDC_TEAM_CLAIM=team
OIDC_PERMISSIONS_CLAIM=permissions
AGENTTEAMS_ENROLLMENT_DEFAULT_TTL=7d
WORKER_ENROLLMENT_DB_PASSWORD=replace-with-a-unique-enrollment-db-password
CREDENTIAL_PROXY_DB_PASSWORD=replace-with-a-unique-credential-proxy-db-password
# Only needed when Compose builds the Credential Proxy image from source. This file is mounted to BuildKit as a secret.
# MAVEN_SETTINGS_FILE=/absolute/path/to/maven-settings.xml
CREDENTIAL_PROXY_UID=10001
CREDENTIAL_PROXY_GID=10001
PROVIDER_CREDENTIALS_DIR=./secrets/provider
AGENTTEAMS_CREDENTIAL_PROXY_UPSTREAM_RESPONSES_URL=https://api.openai.com/v1/responses
AGENTTEAMS_CREDENTIAL_PROXY_ALLOWED_MODELS=gpt-5.6-luna
AGENTTEAMS_CREDENTIAL_PROXY_MAX_ACTIVE_STREAMS=64
AGENTTEAMS_TENANT_CREDENTIAL_REFS_JSON=[{"tenant_id":"tenant-a","project_id":"project-a","team_id":"team-a","model_credential_ref":"file:tenant-a/project-a/team-a/chatgpt"}]
WORKER_REPLICAS=0
# Provision tenant-neutral fixed Worker slot identities before issuing their sessions.
# Set exactly the slot UUIDs enabled for this environment; the db-setup job seeds them.
WORKER_SLOT_IDS_JSON=["00000000-0000-0000-0000-000000000001","00000000-0000-0000-0000-000000000002","00000000-0000-0000-0000-000000000003","00000000-0000-0000-0000-000000000004","00000000-0000-0000-0000-000000000005","00000000-0000-0000-0000-000000000006","00000000-0000-0000-0000-000000000007","00000000-0000-0000-0000-000000000008"]
WORKER_SLOT_SCHEDULING_ENABLED=false
WORKER_1_SLOT_ID=00000000-0000-0000-0000-000000000001
WORKER_2_SLOT_ID=00000000-0000-0000-0000-000000000002
WORKER_3_SLOT_ID=00000000-0000-0000-0000-000000000003
WORKER_4_SLOT_ID=00000000-0000-0000-0000-000000000004
WORKER_5_SLOT_ID=00000000-0000-0000-0000-000000000005
WORKER_6_SLOT_ID=00000000-0000-0000-0000-000000000006
WORKER_7_SLOT_ID=00000000-0000-0000-0000-000000000007
WORKER_8_SLOT_ID=00000000-0000-0000-0000-000000000008
WORKER_1_CREDENTIALS_FILE=./secrets/worker-1.runtime.env
WORKER_2_CREDENTIALS_FILE=./secrets/worker-2.runtime.env
WORKER_3_CREDENTIALS_FILE=./secrets/worker-3.runtime.env
WORKER_4_CREDENTIALS_FILE=./secrets/worker-4.runtime.env
WORKER_5_CREDENTIALS_FILE=./secrets/worker-5.runtime.env
WORKER_6_CREDENTIALS_FILE=./secrets/worker-6.runtime.env
WORKER_7_CREDENTIALS_FILE=./secrets/worker-7.runtime.env
WORKER_8_CREDENTIALS_FILE=./secrets/worker-8.runtime.env
AGENTTEAMS_STORAGE_ENABLED=false
OBJECT_STORE_ACCESS_KEY=agentteams-storage
OBJECT_STORE_SECRET_KEY=replace-with-a-32-character-object-store-secret

# A short-lived Attempt capability is shared by model, Task event and Artifact metadata calls; provider tokens are never mounted into Workers.
