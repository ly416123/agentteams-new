OIDC_TENANT_CLAIM=tenant
OIDC_PROJECT_CLAIM=project
OIDC_TEAM_CLAIM=team
OIDC_PERMISSIONS_CLAIM=permissions
AGENTTEAMS_ENROLLMENT_DEFAULT_TTL=7d
WORKER_ENROLLMENT_DB_PASSWORD=replace-with-a-unique-enrollment-db-password
WORKER_REPLICAS=0
WORKER_1_AGENT_ID=00000000-0000-0000-0000-000000000001
WORKER_2_AGENT_ID=00000000-0000-0000-0000-000000000002
WORKER_3_AGENT_ID=00000000-0000-0000-0000-000000000003
WORKER_4_AGENT_ID=00000000-0000-0000-0000-000000000004
WORKER_5_AGENT_ID=00000000-0000-0000-0000-000000000005
WORKER_6_AGENT_ID=00000000-0000-0000-0000-000000000006
WORKER_7_AGENT_ID=00000000-0000-0000-0000-000000000007
WORKER_8_AGENT_ID=00000000-0000-0000-0000-000000000008
WORKER_1_CREDENTIALS_FILE=./secrets/worker-1.runtime.env
WORKER_2_CREDENTIALS_FILE=./secrets/worker-2.runtime.env
WORKER_3_CREDENTIALS_FILE=./secrets/worker-3.runtime.env
WORKER_4_CREDENTIALS_FILE=./secrets/worker-4.runtime.env
WORKER_5_CREDENTIALS_FILE=./secrets/worker-5.runtime.env
WORKER_6_CREDENTIALS_FILE=./secrets/worker-6.runtime.env
