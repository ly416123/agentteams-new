# Replace these placeholders with immutable GHCR references ending in @sha256:<digest>.
CONTROL_PLANE_IMAGE=ghcr.io/ly416123/agentteams-control-plane@sha256:REPLACE_WITH_RELEASE_DIGEST
GATEWAY_IMAGE=ghcr.io/ly416123/agentteams-agent-gateway@sha256:REPLACE_WITH_RELEASE_DIGEST
WORKER_IMAGE=ghcr.io/ly416123/agentteams-agent-worker@sha256:REPLACE_WITH_RELEASE_DIGEST

# Generate a unique value for each environment. Do not commit the real .env file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
CONTROL_PLANE_PORT=8080
WORKER_REPLICAS=0
WORKER_1_AGENT_ID=00000000-0000-0000-0000-000000000001
WORKER_2_AGENT_ID=00000000-0000-0000-0000-000000000002
WORKER_3_AGENT_ID=00000000-0000-0000-0000-000000000003
WORKER_4_AGENT_ID=00000000-0000-0000-0000-000000000004
WORKER_5_AGENT_ID=00000000-0000-0000-0000-000000000005
WORKER_6_AGENT_ID=00000000-0000-0000-0000-000000000006
WORKER_7_AGENT_ID=00000000-0000-0000-0000-000000000007
WORKER_8_AGENT_ID=00000000-0000-0000-0000-000000000008

# The checked-in example file is empty; replace this path with your provider token file before starting workers.
MODEL_TOKEN_FILE=./model-token.example
