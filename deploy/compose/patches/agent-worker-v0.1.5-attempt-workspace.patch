+package io.agentteams.worker.chatgpt;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import com.sun.net.httpserver.HttpServer;
+import java.net.InetSocketAddress;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.nio.charset.StandardCharsets;
+import java.time.Instant;
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+class AttemptCredentialTokenSourceTest {
+    private HttpServer server;
+    private AtomicInteger requests;
+    private String requestBody;
+    private String authorization;
+
+    @BeforeEach
+    void startServer() throws Exception {
+        requests = new AtomicInteger();
+        server = HttpServer.create(new InetSocketAddress("127.0.0.1", 0), 0);
+        server.createContext("/internal/v1/attempt-credentials", exchange -> {
+            authorization = exchange.getRequestHeaders().getFirst("Authorization");
+            requestBody = new String(exchange.getRequestBody().readAllBytes(), StandardCharsets.UTF_8);
+            int request = requests.incrementAndGet();
+            String response = "{\"token\":\"atp_" + "a".repeat(42) + request
+                    + "\",\"expiresAt\":\"" + Instant.now().plusSeconds(60) + "\"}";
+            byte[] bytes = response.getBytes(StandardCharsets.UTF_8);
+            exchange.getResponseHeaders().add("Content-Type", "application/json");
+            exchange.getResponseHeaders().add("Cache-Control", "no-store");
+            exchange.sendResponseHeaders(201, bytes.length);
+            exchange.getResponseBody().write(bytes);
+            exchange.close();
+        });
+        server.start();
+    }
+
+    @AfterEach
+    void stopServer() {
+        if (server != null) server.stop(0);
+    }
+
+    @Test
+    void reissuesAttemptScopedTokenOnEveryModelRequest() {
+        UUID taskId = UUID.randomUUID();
+        UUID attemptId = UUID.randomUUID();
+        UUID leaseId = UUID.randomUUID();
+        AttemptCredentialTokenSource source = new AttemptCredentialTokenSource(
+                URI.create("http://127.0.0.1:" + server.getAddress().getPort()
+                        + "/internal/v1/attempt-credentials"),
+                "ats_worker_session", taskId, attemptId, leaseId, HttpClient.newHttpClient());
+
+        String first = source.accessToken();
+        String second = source.accessToken();
+
+        assertThat(first).startsWith("atp_");
+        assertThat(second).startsWith("atp_").isNotEqualTo(first);
+        assertThat(requests).hasValue(2);
+        assertThat(authorization).isEqualTo("Bearer ats_worker_session");
+        assertThat(requestBody).contains(taskId.toString(), attemptId.toString(), leaseId.toString());
+        assertThat(requestBody).doesNotContain("tenant", "credentialRef", "modelCredentialRef");
+    }
+
+    @Test
+    void rejectsAResponseWithoutAValidShortLivedAttemptToken() {
+        server.removeContext("/internal/v1/attempt-credentials");
+        server.createContext("/internal/v1/attempt-credentials", exchange -> {
+            byte[] bytes = "{\"token\":\"provider-secret\",\"expiresAt\":\"2999-01-01T00:00:00Z\"}"
+                    .getBytes(StandardCharsets.UTF_8);
+            exchange.sendResponseHeaders(201, bytes.length);
+            exchange.getResponseBody().write(bytes);
+            exchange.close();
+        });
+        AttemptCredentialTokenSource source = new AttemptCredentialTokenSource(
+                URI.create("http://127.0.0.1:" + server.getAddress().getPort()
+                        + "/internal/v1/attempt-credentials"),
+                "ats_worker_session", UUID.randomUUID(), UUID.randomUUID(), UUID.randomUUID(),
+                HttpClient.newHttpClient());
+
+        assertThatThrownBy(source::accessToken).isInstanceOf(IllegalStateException.class)
+                .hasMessage("Attempt credential could not be issued");
+    }
+}
