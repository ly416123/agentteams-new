@@ -0,0 +1,66 @@
+package io.agentteams.worker.chatgpt;
+
+import io.agentteams.runtime.RuntimeAttemptCapabilityPort;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.time.Clock;
+import java.util.Objects;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ConcurrentMap;
+
+/** Shares one cached capability source between model calls and Gateway execution events. */
+public final class AttemptCapabilityTokenRegistry implements RuntimeAttemptCapabilityPort {
+    private final URI endpoint;
+    private final String workerSlotSessionToken;
+    private final HttpClient http;
+    private final Clock clock;
+    private final ConcurrentMap<UUID, BoundSource> sources = new ConcurrentHashMap<>();
+
+    public AttemptCapabilityTokenRegistry(URI endpoint, String workerSlotSessionToken, HttpClient http, Clock clock) {
+        this.endpoint = Objects.requireNonNull(endpoint, "endpoint");
+        this.workerSlotSessionToken = Objects.requireNonNull(workerSlotSessionToken, "workerSlotSessionToken");
+        this.http = Objects.requireNonNull(http, "http");
+        this.clock = Objects.requireNonNull(clock, "clock");
+    }
+
+    public AttemptCapabilityTokenSource source(UUID taskId, UUID assignmentId, UUID attemptId, UUID leaseId) {
+        Objects.requireNonNull(taskId, "taskId");
+        Objects.requireNonNull(assignmentId, "assignmentId");
+        Objects.requireNonNull(attemptId, "attemptId");
+        Objects.requireNonNull(leaseId, "leaseId");
+        BoundSource bound = sources.compute(taskId, (ignored, current) -> {
+            if (current != null && current.matches(assignmentId, attemptId, leaseId)) return current;
+            return new BoundSource(assignmentId, attemptId, leaseId,
+                    new AttemptCapabilityTokenSource(endpoint, workerSlotSessionToken, taskId,
+                            assignmentId, attemptId, leaseId, http, clock));
+        });
+        return bound.source();
+    }
+
+    @Override
+    public String accessToken(UUID taskId, String assignmentId, String attemptId, String leaseId) {
+        return source(taskId, uuid(assignmentId, "assignmentId"), uuid(attemptId, "attemptId"),
+                uuid(leaseId, "leaseId")).accessToken();
+    }
+
+    @Override
+    public void release(UUID taskId) {
+        if (taskId != null) sources.remove(taskId);
+    }
+
+    private static UUID uuid(String value, String field) {
+        try {
+            return UUID.fromString(value);
+        } catch (RuntimeException malformed) {
+            throw new IllegalArgumentException("Attempt capability " + field + " is invalid", malformed);
+        }
+    }
+
+    private record BoundSource(UUID assignmentId, UUID attemptId, UUID leaseId,
+            AttemptCapabilityTokenSource source) {
+        private boolean matches(UUID assignment, UUID attempt, UUID lease) {
+            return assignmentId.equals(assignment) && attemptId.equals(attempt) && leaseId.equals(lease);
+        }
+    }
+}
