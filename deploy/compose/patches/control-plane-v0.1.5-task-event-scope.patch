@@ -0,0 +1,66 @@
+package io.agentteams.controlplane.application;
+
+import io.agentteams.application.api.ExecutionEventPort.TaskEventReportCommand;
+import java.util.Objects;
+import java.util.UUID;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+/** Validates a TASK_EVENT against the active assignment while holding its rows stable through projection. */
+@Service
+public class JdbcTaskEventScopeGuard implements TaskEventScopeGuard {
+    private static final String ACTIVE_ASSIGNMENT_SQL = """
+            SELECT 1
+              FROM public.task_assignments AS assignment
+              JOIN public.task_attempts AS attempt
+                ON attempt.id = assignment.attempt_id
+               AND attempt.task_id = assignment.task_id
+              JOIN public.agent_leases AS lease
+                ON lease.id = attempt.lease_id
+               AND lease.task_attempt_id = attempt.id
+               AND lease.agent_id = assignment.agent_id
+              JOIN public.resource_scopes AS worker_scope
+                ON worker_scope.resource_type = 'WORKER'
+               AND worker_scope.resource_id = assignment.agent_id
+              JOIN public.resource_scopes AS task_scope
+                ON task_scope.resource_type = 'TASK'
+               AND task_scope.resource_id = assignment.task_id
+             WHERE assignment.task_id = ?
+               AND assignment.attempt_id = ?
+               AND assignment.agent_id = ?::uuid
+               AND assignment.phase IN ('ASSIGNED', 'ACCEPTED', 'RUNNING')
+               AND assignment.released_at IS NULL
+               AND attempt.phase IN ('ASSIGNED', 'ACCEPTED', 'RUNNING')
+               AND attempt.lease_expires_at > statement_timestamp()
+               AND lease.id = ?
+               AND lease.status = 'ACTIVE'
+               AND lease.released_at IS NULL
+               AND lease.expires_at > statement_timestamp()
+               AND worker_scope.tenant_id = task_scope.tenant_id
+               AND worker_scope.project_id = task_scope.project_id
+               AND worker_scope.team = task_scope.team
+             LIMIT 1
+             FOR SHARE OF assignment, attempt, lease, worker_scope, task_scope
+            """;
+
+    private final JdbcTemplate jdbc;
+
+    public JdbcTaskEventScopeGuard(JdbcTemplate jdbc) {
+        this.jdbc = Objects.requireNonNull(jdbc, "jdbc");
+    }
+
+    @Override
+    @Transactional
+    public boolean runIfActive(UUID taskId, TaskEventReportCommand command, Runnable projection) {
+        Objects.requireNonNull(taskId, "taskId");
+        Objects.requireNonNull(command, "command");
+        Objects.requireNonNull(projection, "projection");
+        Boolean active = jdbc.query(ACTIVE_ASSIGNMENT_SQL,
+                (org.springframework.jdbc.core.ResultSetExtractor<Boolean>) rs -> rs.next(), taskId,
+                command.attemptId(), command.agentId(), command.leaseId());
+        if (!Boolean.TRUE.equals(active)) return false;
+        projection.run();
+        return true;
+    }
+}
