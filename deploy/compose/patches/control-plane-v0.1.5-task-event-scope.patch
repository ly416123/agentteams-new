+package io.agentteams.controlplane.scheduling;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.UUID;
+
+/** Deterministic weighted-deficit selection across tenant queues for a fixed number of Worker slots. */
+public final class TenantFairQueue {
+    private final Map<UUID, Integer> deficitByTenant = new HashMap<>();
+    private UUID nextTenant;
+
+    public synchronized List<UUID> select(List<TenantQueue> queues, int globalSlots) {
+        Objects.requireNonNull(queues, "queues");
+        if (globalSlots < 0) throw new IllegalArgumentException("globalSlots must not be negative");
+        List<TenantQueue> ordered = queues.stream().sorted(Comparator.comparing(TenantQueue::tenantId)).toList();
+        Map<UUID, TenantQueue> byTenant = new HashMap<>();
+        for (TenantQueue queue : ordered) {
+            if (byTenant.put(queue.tenantId(), queue) != null) {
+                throw new IllegalArgumentException("tenant queue must be unique");
+            }
+        }
+        deficitByTenant.keySet().retainAll(byTenant.keySet());
+        if (ordered.isEmpty()) {
+            nextTenant = null;
+            return List.of();
+        }
+        if (nextTenant == null || !byTenant.containsKey(nextTenant)) nextTenant = ordered.get(0).tenantId();
+        List<UUID> selected = new ArrayList<>(globalSlots);
+        int cursor = indexOf(ordered, nextTenant);
+        int idleVisits = 0;
+        while (selected.size() < globalSlots && idleVisits < ordered.size()) {
+            TenantQueue queue = ordered.get(cursor);
+            if (queue.tasks().isEmpty() || queue.activeAttempts() + selectedCount(selected, queue.tenantId())
+                    >= queue.maxActiveAttempts()) {
+                deficitByTenant.put(queue.tenantId(), 0);
+                cursor = (cursor + 1) % ordered.size();
+                nextTenant = ordered.get(cursor).tenantId();
+                idleVisits++;
+                continue;
+            }
+            int deficit = deficitByTenant.getOrDefault(queue.tenantId(), 0);
+            if (deficit == 0) deficit = queue.weight();
+            selected.add(queue.tenantId());
+            queue.tasks().remove(0);
+            deficitByTenant.put(queue.tenantId(), deficit - 1);
+            if (deficit - 1 == 0) {
+                cursor = (cursor + 1) % ordered.size();
+                nextTenant = ordered.get(cursor).tenantId();
+            }
+            idleVisits = selected.isEmpty() ? idleVisits + 1 : 0;
+        }
+        return List.copyOf(selected);
+    }
+
+    private static int indexOf(List<TenantQueue> queues, UUID tenantId) {
+        for (int i = 0; i < queues.size(); i++) if (queues.get(i).tenantId().equals(tenantId)) return i;
+        return 0;
+    }
+
+    private static long selectedCount(List<UUID> selected, UUID tenantId) {
+        return selected.stream().filter(tenantId::equals).count();
+    }
+
+    public record TenantQueue(UUID tenantId, int weight, int activeAttempts, int maxActiveAttempts,
+            List<UUID> tasks) {
+        public TenantQueue {
+            Objects.requireNonNull(tenantId, "tenantId");
+            Objects.requireNonNull(tasks, "tasks");
+            if (weight < 1 || weight > 100) throw new IllegalArgumentException("weight must be 1..100");
+            if (activeAttempts < 0 || maxActiveAttempts < 1 || activeAttempts > maxActiveAttempts) {
+                throw new IllegalArgumentException("invalid tenant active attempt quota");
+            }
+            tasks = new ArrayList<>(tasks);
+        }
+    }
+}
