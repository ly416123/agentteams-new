@@ -0,0 +1,135 @@
+package io.agentteams.controlplane.application;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+
+import io.agentteams.application.api.ExecutionEventPort.TaskEventReportCommand;
+import io.agentteams.application.api.TaskExecutionObservationPort;
+import io.agentteams.controlplane.audit.ModelCallAuditRecorder;
+import io.agentteams.controlplane.service.ExecutionEventService;
+import java.time.Instant;
+import java.util.UUID;
+import javax.sql.DataSource;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.postgresql.ds.PGSimpleDataSource;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.datasource.DataSourceTransactionManager;
+import org.springframework.transaction.support.TransactionTemplate;
+import org.testcontainers.containers.PostgreSQLContainer;
+import org.testcontainers.junit.jupiter.Container;
+import org.testcontainers.junit.jupiter.Testcontainers;
+
+@Testcontainers(disabledWithoutDocker = true)
+class JdbcTaskEventScopeGuardPostgresTest {
+    @Container
+    static final PostgreSQLContainer<?> POSTGRES = new PostgreSQLContainer<>("postgres:16-alpine");
+    private static JdbcTemplate jdbc;
+    private static TransactionTemplate transactions;
+    private static JdbcTaskEventScopeGuard guard;
+
+    private static final UUID TASK_A = UUID.fromString("10000000-0000-0000-0000-000000000001");
+    private static final UUID ATTEMPT_A = UUID.fromString("20000000-0000-0000-0000-000000000001");
+    private static final UUID LEASE_A = UUID.fromString("30000000-0000-0000-0000-000000000001");
+    private static final UUID AGENT_A = UUID.fromString("40000000-0000-0000-0000-000000000001");
+    private static final UUID TASK_B = UUID.fromString("10000000-0000-0000-0000-000000000002");
+    private static final UUID ATTEMPT_B = UUID.fromString("20000000-0000-0000-0000-000000000002");
+    private static final UUID LEASE_B = UUID.fromString("30000000-0000-0000-0000-000000000002");
+    private static final UUID AGENT_B = UUID.fromString("40000000-0000-0000-0000-000000000002");
+
+    @BeforeAll
+    static void createSchema() {
+        DataSource dataSource = dataSource();
+        jdbc = new JdbcTemplate(dataSource);
+        transactions = new TransactionTemplate(new DataSourceTransactionManager(dataSource));
+        guard = new JdbcTaskEventScopeGuard(jdbc);
+        jdbc.execute("CREATE TABLE task_assignments (task_id uuid, attempt_id uuid, agent_id uuid, phase text, released_at timestamptz)");
+        jdbc.execute("CREATE TABLE task_attempts (id uuid, task_id uuid, lease_id uuid, phase text, lease_expires_at timestamptz)");
+        jdbc.execute("CREATE TABLE agent_leases (id uuid, agent_id uuid, task_attempt_id uuid, expires_at timestamptz, released_at timestamptz, status text)");
+        jdbc.execute("CREATE TABLE resource_scopes (resource_type text, resource_id uuid, tenant_id text, project_id text, team text)");
+    }
+
+    @BeforeEach
+    void seedTenants() {
+        jdbc.execute("TRUNCATE task_assignments, task_attempts, agent_leases, resource_scopes");
+        insertExecution(TASK_A, ATTEMPT_A, LEASE_A, AGENT_A, "tenant-a", "project-a", "team-a");
+        insertExecution(TASK_B, ATTEMPT_B, LEASE_B, AGENT_B, "tenant-b", "project-b", "team-b");
+    }
+
+    @Test
+    void acceptsOnlyLiveAttemptAndLeaseOwnedByTheAgentInTheSameScope() {
+        assertThat(run(TASK_A, ATTEMPT_A, LEASE_A, AGENT_A)).isTrue();
+        assertThat(run(TASK_B, ATTEMPT_B, LEASE_B, AGENT_A)).isFalse();
+        assertThat(run(TASK_A, ATTEMPT_B, LEASE_B, AGENT_B)).isFalse();
+        assertThat(run(TASK_A, ATTEMPT_A, LEASE_B, AGENT_A)).isFalse();
+    }
+
+    @Test
+    void rejectsExpiredOrReleasedExecutionAndDoesNotProjectTheEvent() {
+        jdbc.update("UPDATE agent_leases SET expires_at = now() - interval '1 second' WHERE id = ?", LEASE_A);
+        assertThat(run(TASK_A, ATTEMPT_A, LEASE_A, AGENT_A)).isFalse();
+        jdbc.update("UPDATE agent_leases SET expires_at = now() + interval '1 hour', released_at = now() WHERE id = ?",
+                LEASE_A);
+        assertThat(run(TASK_A, ATTEMPT_A, LEASE_A, AGENT_A)).isFalse();
+    }
+
+    @Test
+    void rejectsCrossTenantTaskEvenWhenAttemptAndLeaseAreInternallyConsistent() {
+        jdbc.update("UPDATE resource_scopes SET tenant_id = 'tenant-b', project_id = 'project-b', team = 'team-b' "
+                + "WHERE resource_type = 'TASK' AND resource_id = ?", TASK_A);
+        assertThat(run(TASK_A, ATTEMPT_A, LEASE_A, AGENT_A)).isFalse();
+    }
+
+    @Test
+    void taskEventAdapterProjectsOnlyInsideTheDatabaseValidatedActiveScope() {
+        TaskExecutionObservationPort observations = mock(TaskExecutionObservationPort.class);
+        ControlPlaneExecutionEventAdapter adapter = new ControlPlaneExecutionEventAdapter(
+                mock(ExecutionEventService.class), ModelCallAuditRecorder.noop(), observations, guard);
+        TaskEventReportCommand command = new TaskEventReportCommand(UUID.randomUUID(), ATTEMPT_A, LEASE_A,
+                Instant.now(), AGENT_A.toString(), "tool.started", "{}", 1, "correlation");
+
+        transactions.execute(status -> {
+            adapter.taskEventReport(TASK_B, command);
+            adapter.taskEventReport(TASK_A, command);
+            return null;
+        });
+
+        verify(observations, never()).observed(eq(TASK_B), any(), any(), any(), any(), any(), any());
+        verify(observations).observed(eq(TASK_A), eq(ATTEMPT_A), eq(command.eventId()), eq(command.occurredAt()),
+                eq(command.correlationId()), eq(command.eventType()), eq(command.payloadJson()));
+    }
+
+    private static boolean run(UUID taskId, UUID attemptId, UUID leaseId, UUID agentId) {
+        TaskEventReportCommand command = new TaskEventReportCommand(UUID.randomUUID(), attemptId, leaseId,
+                Instant.now(), agentId.toString(), "tool.started", "{}", 1, "correlation");
+        boolean[] projected = {false};
+        boolean accepted = transactions.execute(status -> guard.runIfActive(taskId, command,
+                () -> projected[0] = true));
+        assertThat(projected[0]).isEqualTo(accepted);
+        return accepted;
+    }
+
+    private static void insertExecution(UUID task, UUID attempt, UUID lease, UUID agent, String tenant,
+            String project, String team) {
+        jdbc.update("INSERT INTO task_assignments VALUES (?, ?, ?, 'RUNNING', NULL)", task, attempt, agent);
+        jdbc.update("INSERT INTO task_attempts VALUES (?, ?, ?, 'RUNNING', now() + interval '1 hour')",
+                attempt, task, lease);
+        jdbc.update("INSERT INTO agent_leases VALUES (?, ?, ?, now() + interval '1 hour', NULL, 'ACTIVE')",
+                lease, agent, attempt);
+        jdbc.update("INSERT INTO resource_scopes VALUES ('WORKER', ?, ?, ?, ?)", agent, tenant, project, team);
+        jdbc.update("INSERT INTO resource_scopes VALUES ('TASK', ?, ?, ?, ?)", task, tenant, project, team);
+    }
+
+    private static DataSource dataSource() {
+        PGSimpleDataSource dataSource = new PGSimpleDataSource();
+        dataSource.setURL(POSTGRES.getJdbcUrl());
+        dataSource.setUser(POSTGRES.getUsername());
+        dataSource.setPassword(POSTGRES.getPassword());
+        return dataSource;
+    }
+}
