+            }
+            WorkerOperation drain = tx.workerOperations().findLatestDrain(agentId)
+                    .orElseThrow(() -> new WorkerLifecycleConflictException("WORKER_NOT_DRAINED"));
+            if (drain.status() != WorkerOperationStatus.DRAINED) {
+                throw new WorkerLifecycleConflictException("WORKER_NOT_DRAINED");
+            }
+            if (!tx.workerOperations().isGatewayOnline(agentId, now.minusSeconds(30))) {
+                throw new WorkerLifecycleConflictException("WORKER_NOT_ONLINE");
+            }
+            tx.agents().updatePhase(agentId, AgentPhase.READY, expectedAgentVersion, now);
+            WorkerOperation activated = new WorkerOperation(UUID.randomUUID(), agentId, WorkerOperationType.ACTIVATE,
+                    WorkerOperationStatus.SUCCEEDED, null, null, null, null, "{}", idempotencyKey,
+                    expectedAgentVersion, PrincipalContext.actorOr("control-plane"), null, null,
+                    correlationOrRandom(), now, now, 0);
+            tx.workerOperations().insert(activated);
+            FoundationPersistenceService.appendEvent(tx, "agent", agentId, "WorkerActivated",
+                    "{\"operationId\":\"" + activated.id() + "\"}", now, expectedAgentVersion + 1);
+            return activated;
+        });
+    }
