+package io.agentteams.controlplane.scheduling;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+
+class TenantFairQueueTest {
+    private static final UUID TENANT_A = UUID.fromString("00000000-0000-0000-0000-000000000001");
+    private static final UUID TENANT_B = UUID.fromString("00000000-0000-0000-0000-000000000002");
+
+    @Test
+    void weightedDeficitRoundRobinPreservesLongTermTenantWeights() {
+        TenantFairQueue queue = new TenantFairQueue();
+        List<UUID> selected = new ArrayList<>();
+        for (int i = 0; i < 30; i++) {
+            selected.addAll(queue.select(List.of(tenant(TENANT_A, 2, 0, 100, 30),
+                    tenant(TENANT_B, 1, 0, 100, 30)), 1));
+        }
+        assertThat(selected).filteredOn(TENANT_A::equals).hasSize(20);
+        assertThat(selected).filteredOn(TENANT_B::equals).hasSize(10);
+    }
+
+    @Test
+    void activeQuotaAndGlobalSlotsBoundEachSelection() {
+        TenantFairQueue queue = new TenantFairQueue();
+        assertThat(queue.select(List.of(tenant(TENANT_A, 10, 2, 2, 10),
+                tenant(TENANT_B, 1, 0, 1, 10)), 2)).containsExactly(TENANT_B);
+    }
+
+    @Test
+    void skipsEmptyAndQuotaBlockedTenantsWithoutLosingOtherTenantCapacity() {
+        TenantFairQueue queue = new TenantFairQueue();
+        assertThat(queue.select(List.of(tenant(TENANT_A, 1, 0, 2, 0),
+                tenant(TENANT_B, 1, 2, 2, 5)), 3)).isEmpty();
+        assertThat(queue.select(List.of(tenant(TENANT_B, 1, 0, 2, 5)), 2))
+                .containsExactly(TENANT_B, TENANT_B);
+    }
+
+    @Test
+    void validatesTenantWeightsAndQuotaInputs() {
+        assertThatThrownBy(() -> tenant(TENANT_A, 0, 0, 1, 1)).isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> tenant(TENANT_A, 1, 2, 1, 1)).isInstanceOf(IllegalArgumentException.class);
+    }
+
+    private static TenantFairQueue.TenantQueue tenant(UUID id, int weight, int active, int maximum, int queued) {
+        List<UUID> tasks = new ArrayList<>();
+        for (int i = 0; i < queued; i++) tasks.add(UUID.nameUUIDFromBytes((id + ":" + i).getBytes()));
+        return new TenantFairQueue.TenantQueue(id, weight, active, maximum, tasks);
+    }
+}
