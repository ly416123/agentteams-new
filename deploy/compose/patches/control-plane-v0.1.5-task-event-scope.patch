+    /** Re-enables a drained, still registered worker after the Gateway reconnects. */
+    public WorkerOperation activate(UUID agentId, long expectedAgentVersion, String idempotencyKey) {
+        Objects.requireNonNull(agentId, "agentId");
+        requireKey(idempotencyKey);
