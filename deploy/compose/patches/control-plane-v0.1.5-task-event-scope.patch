@@ -0,0 +1,15 @@
+package io.agentteams.controlplane.application;
+
+import io.agentteams.application.api.ExecutionEventPort.TaskEventReportCommand;
+import java.util.UUID;
+
+/** Checks the live task/attempt/lease/agent relation before projecting a Worker event. */
+@FunctionalInterface
+public interface TaskEventScopeGuard {
+    boolean runIfActive(UUID taskId, TaskEventReportCommand command, Runnable projection);
+
+    /** Safe default for tests and any unconfigured adapter: never project unverified Worker events. */
+    static TaskEventScopeGuard rejectAll() {
+        return (taskId, command, projection) -> false;
+    }
+}
