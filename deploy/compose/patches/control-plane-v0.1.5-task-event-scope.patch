+import io.agentteams.gateway.JdbcAgentStateStore;
+import io.nats.client.Connection;
+import io.nats.client.JetStreamManagement;
+import io.nats.client.Nats;
+import io.nats.client.api.StorageType;
+import io.nats.client.api.StreamConfiguration;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.SecureRandom;
+import java.time.Duration;
+import java.util.Base64;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.TimeUnit;
+import java.util.function.BooleanSupplier;
+import javax.sql.DataSource;
+import org.junit.jupiter.api.AfterAll;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import org.springframework.boot.builder.SpringApplicationBuilder;
+import org.springframework.boot.web.context.WebServerApplicationContext;
+import org.springframework.context.ConfigurableApplicationContext;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.testcontainers.containers.GenericContainer;
+import org.testcontainers.containers.PostgreSQLContainer;
+import org.testcontainers.junit.jupiter.Container;
+import org.testcontainers.junit.jupiter.Testcontainers;
+import org.testcontainers.utility.DockerImageName;
+
+/** Real gRPC -> Gateway -> JetStream -> Control Plane negative tenant-boundary acceptance. */
+@Testcontainers(disabledWithoutDocker = true)
+class TaskEventScopeEndToEndIT {
+    private static final String DATABASE_USER = "agentteams";
+    private static final String DATABASE_PASSWORD = "agentteams-dev";
+    private static final String TENANT_A = "tenant-a";
+    private static final String PROJECT_A = "project-a";
+    private static final String TEAM_A = "team-a";
+    private static final SecureRandom RANDOM = new SecureRandom();
+    private static final Map<UUID, String> SESSION_TOKENS = new ConcurrentHashMap<>();
+    private static final ObjectMapper JSON = new ObjectMapper();
+
+    @Container
+    static final PostgreSQLContainer<?> POSTGRES = new PostgreSQLContainer<>(DockerImageName.parse("postgres:16-alpine"))
+            .withDatabaseName("agentteams").withUsername(DATABASE_USER).withPassword(DATABASE_PASSWORD);
+
+    @Container
+    static final GenericContainer<?> NATS = new GenericContainer<>(DockerImageName.parse("nats:2.10-alpine"))
+            .withCommand("-js").withExposedPorts(4222);
+
+    private static ConfigurableApplicationContext controlPlane;
+    private static ConfigurableApplicationContext gateway;
+    private static Connection natsConnection;
+
+    @BeforeAll
+    static void startApplications() throws Exception {
+        natsConnection = Nats.connect(natsUrl());
+        createStreams(natsConnection.jetStreamManagement());
+        controlPlane = new SpringApplicationBuilder(io.agentteams.controlplane.ControlPlaneApplication.class)
+                .run(commandLineProperties(controlPlaneProperties()));
+        gateway = new SpringApplicationBuilder(io.agentteams.gateway.AgentGatewayApplication.class)
+                .run(commandLineProperties(gatewayProperties()));
+    }
+
+    @AfterAll
+    static void stopApplications() {
+        if (gateway != null) gateway.close();
+        if (controlPlane != null) controlPlane.close();
+        if (natsConnection != null) {
+            try { natsConnection.close(); } catch (InterruptedException interrupted) {
+                Thread.currentThread().interrupt();
+            }
+        }
+    }
+
+    @Test
+    void rejectsCrossTenantTaskEventWithoutRunProcessOrWebhookSideEffects() throws Exception {
+        assertNotNull(controlPlane);
+        assertEquals(JdbcAgentStateStore.class, gateway.getBean(AgentStatePort.class).getClass());
+        UUID agentId = createAgent();
+        try (FakeAgent agent = FakeAgent.connect("127.0.0.1", gatewayPort(), agentId.toString(),
+                ProtocolVersion.newBuilder().setMajor(2).setMinor(3).build(), Map.of("tasks", "1"),
+                SESSION_TOKENS.get(agentId))) {
+            agent.awaitReady();
+            UUID sourceTaskId = createQueuedTask();
+            var assignment = agent.awaitTaskAssigned(sourceTaskId.toString());
+            agent.accept(assignment);
+            agent.progress(assignment);
+            awaitTaskPhase(sourceTaskId, "RUNNING");
+            UUID targetTaskId = createUnqueuedTenantBTask();
+            UUID eventId = UUID.randomUUID();
+            createTenantBWebhook();
+            long previousStreamSequence = natsConnection.jetStreamManagement()
+                    .getStreamInfo("AGENT_EVENTS").getStreamState().getLastSequence();
+
+            agent.reportTaskEventForTask(assignment, targetTaskId.toString(), eventId.toString());
+            long eventStreamSequence = awaitPublishedTaskEvent(previousStreamSequence, targetTaskId, eventId);
+            awaitConsumerAck(eventStreamSequence);
+
+            assertEquals(0, countByTask("task_runs", targetTaskId), "cross-tenant event must not create a Run");
+            assertEquals(0, countByTask("task_process_events", targetTaskId),
+                    "cross-tenant event must not write a process event");
+            assertEquals(0, countByEvent("webhook_deliveries", eventId),
+                    "cross-tenant event must not enqueue a Webhook delivery");
+        }
+    }
+
+    @Test
+    void rejectsCrossTenantConfigAppliedFromGatewayWithoutMutatingForeignApply() throws Exception {
+        UUID submittingAgentId = createAgent();
+        UUID bindingOwnerAgentId = createAgent();
+        jdbc().update("""
+                UPDATE resource_scopes
+                   SET tenant_id = 'tenant-b', project_id = 'project-b', team = 'team-b'
+                 WHERE resource_type = 'WORKER' AND resource_id = ?
+                """, bindingOwnerAgentId);
+
+        try (FakeAgent submittingAgent = FakeAgent.connect("127.0.0.1", gatewayPort(), submittingAgentId.toString(),
+                ProtocolVersion.newBuilder().setMajor(2).setMinor(3).build(), Map.of("tasks", "1"),
+                SESSION_TOKENS.get(submittingAgentId))) {
+            submittingAgent.awaitReady();
+            JsonNode snapshot = postJson("/api/v1/config/snapshots", "config-snapshot-" + UUID.randomUUID(), """
+                    {"subject":"scope-e2e-%s","manifest":{"model":"cross-tenant-test","provider_id":"fake"},
+                     "actor":"integration-test"}
+                    """.formatted(UUID.randomUUID()));
+            UUID snapshotId = UUID.fromString(snapshot.path("id").asText());
+            JsonNode targetDeployment = postJson("/api/v1/config/snapshots/" + snapshotId + "/agents/"
+                    + bindingOwnerAgentId, "config-deploy-" + UUID.randomUUID(), "{}");
+            UUID bindingId = UUID.fromString(targetDeployment.path("bindingId").asText());
+            long previousSequence = natsConnection.jetStreamManagement()
+                    .getStreamInfo("AGENT_EVENTS").getStreamState().getLastSequence();
+
+            ConfigChanged forged = ConfigChanged.newBuilder()
+                    .setMetadata(EventMetadata.newBuilder().setEventId(targetDeployment.path("eventId").asText()))
+                    .setConfigVersion(snapshot.path("version").asLong())
+                    .setBindingId(bindingId.toString())
+                    .setSnapshotId(snapshotId.toString())
+                    .build();
+            submittingAgent.applyConfig(forged);
+            awaitConsumerAck(previousSequence + 1);
+
+            assertEquals("PENDING", jdbc().queryForObject(
+                    "SELECT phase FROM config_apply_records WHERE binding_id = ? AND snapshot_id = ?",
+                    String.class, bindingId, snapshotId),
+                    "Tenant A Agent must not acknowledge Tenant B Agent's config binding");
+        }
+    }
+
+    private static UUID createAgent() throws Exception {
+        JsonNode response = postJson("/api/v1/agents", "agent-" + UUID.randomUUID(), """
+                {"name":"scope-e2e-%s","runtime":"fake-agent","capabilities":{"tasks":"1"},"metadata":{}}
+                """.formatted(UUID.randomUUID()));
+        UUID agentId = UUID.fromString(response.path("id").asText());
+        bindScope("WORKER", agentId, TENANT_A, PROJECT_A, TEAM_A);
+        String token = "ats_" + Base64.getUrlEncoder().withoutPadding().encodeToString(randomBytes(32));
+        jdbc().update("""
+                INSERT INTO agent_sessions(id, agent_id, token_sha256, expires_at, created_at)
+                VALUES (?, ?, ?, ?, CURRENT_TIMESTAMP)
+                """, UUID.randomUUID(), agentId, sha256(token.getBytes(StandardCharsets.UTF_8)),
+                java.sql.Timestamp.from(java.time.Instant.now().plus(Duration.ofHours(1))));
+        SESSION_TOKENS.put(agentId, token);
+        return agentId;
+    }
+
+    private static UUID createQueuedTask() throws Exception {
+        UUID taskId = createTask("tenant A active worker task");
+        bindScope("TASK", taskId, TENANT_A, PROJECT_A, TEAM_A);
+        postJson("/api/v1/tasks/" + taskId + "/queue", "queue-" + UUID.randomUUID(), "{}");
+        return taskId;
+    }
+
+    private static UUID createUnqueuedTenantBTask() throws Exception {
+        UUID taskId = createTask("tenant B target task");
+        bindScope("TASK", taskId, "tenant-b", "project-b", "team-b");
+        return taskId;
+    }
+
+    private static UUID createTask(String title) throws Exception {
+        JsonNode response = postJson("/api/v1/tasks", "task-" + UUID.randomUUID(), """
+                {"title":"%s","description":"TASK_EVENT scope acceptance","spec":{"taskType":"demo"}}
+                """.formatted(title));
+        return UUID.fromString(response.path("id").asText());
+    }
+
+    private static void createTenantBWebhook() {
+        jdbc().update("""
+                INSERT INTO webhook_subscriptions
+                    (id, organization_id, tenant_id, project_id, endpoint, secret_ref, event_types, enabled,
+                     version, created_at, updated_at)
+                VALUES (?, 'legacy:tenant-b', 'tenant-b', 'project-b', ?, ?, ?::jsonb, TRUE, 0,
+                        CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)
+                """, UUID.randomUUID(), "http://127.0.0.1:9/cross-tenant-test", "integration-secret-ref",
+                "[\"task.process\"]");
+    }
+
+    private static void bindScope(String type, UUID id, String tenant, String project, String team) {
+        jdbc().update("""
+                INSERT INTO resource_scopes(resource_type, resource_id, tenant_id, project_id, team,
+                                            created_at, updated_at)
+                VALUES (?, ?, ?, ?, ?, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)
+                """, type, id, tenant, project, team);
+    }
+
+    private static void awaitTaskPhase(UUID taskId, String expected) {
+        long deadline = System.nanoTime() + Duration.ofSeconds(15).toNanos();
+        while (System.nanoTime() < deadline) {
+            String phase = jdbc().queryForObject("SELECT phase FROM tasks WHERE id = ?", String.class, taskId);
+            if (expected.equals(phase)) return;
+            Thread.yield();
+        }
+        assertEquals(expected, jdbc().queryForObject("SELECT phase FROM tasks WHERE id = ?", String.class, taskId));
+    }
+
+    private static int countByTask(String table, UUID taskId) {
+        if (!java.util.Set.of("task_runs", "task_process_events").contains(table)) {
+            throw new IllegalArgumentException("unsupported table");
+        }
+        Integer count = jdbc().queryForObject("SELECT count(*) FROM " + table + " WHERE task_id = ?",
+                Integer.class, taskId);
+        return count == null ? 0 : count;
+    }
+
+    private static int countByEvent(String table, UUID eventId) {
+        if (!"webhook_deliveries".equals(table)) throw new IllegalArgumentException("unsupported table");
+        Integer count = jdbc().queryForObject("SELECT count(*) FROM webhook_deliveries WHERE event_id = ?",
+                Integer.class, eventId);
+        return count == null ? 0 : count;
+    }
+
+    private static long awaitPublishedTaskEvent(long previousSequence, UUID taskId, UUID eventId) throws Exception {
+        long deadline = System.nanoTime() + Duration.ofSeconds(15).toNanos();
+        while (System.nanoTime() < deadline) {
+            long lastSequence = natsConnection.jetStreamManagement()
+                    .getStreamInfo("AGENT_EVENTS").getStreamState().getLastSequence();
+            for (long sequence = previousSequence + 1; sequence <= lastSequence; sequence++) {
+                JsonNode envelope = JSON.readTree(natsConnection.jetStreamManagement()
+                        .getMessage("AGENT_EVENTS", sequence).getData());
+                if (eventId.toString().equals(envelope.path("taskEventReport").path("eventId").asText())) {
+                    assertEquals("TASK_EVENT", envelope.path("type").asText());
+                    assertEquals(taskId.toString(), envelope.path("taskId").asText());
+                    return sequence;
+                }
+            }
+            Thread.yield();
+        }
+        throw new AssertionError("Gateway must publish the cross-tenant TASK_EVENT to JetStream");
+    }
+
+    private static void awaitConsumerAck(long expectedSequence) {
+        long deadline = System.nanoTime() + Duration.ofSeconds(15).toNanos();
+        while (System.nanoTime() < deadline) {
+            try {
+                var info = natsConnection.jetStreamManagement()
+                        .getConsumerInfo("AGENT_EVENTS", "control-plane-execution-events");
+                if (info.getAckFloor() != null && info.getAckFloor().getStreamSequence() >= expectedSequence) return;
+            } catch (Exception ignored) { }
+            Thread.yield();
+        }
+        assertTrue(false, "Control Plane must ACK the injected TASK_EVENT");
+    }
+
+    private static void createStreams(JetStreamManagement management) throws Exception {
+        management.addStream(StreamConfiguration.builder().name("TASK_EVENTS")
+                .subjects("task.events.*").storageType(StorageType.Memory).build());
+        management.addStream(StreamConfiguration.builder().name("AGENT_EVENTS")
+                .subjects("agent.events.*").storageType(StorageType.Memory).build());
+    }
+
+    private static String[] controlPlaneProperties() {
+        return new String[] {"server.address=127.0.0.1", "server.port=0", "spring.datasource.url=" + POSTGRES.getJdbcUrl(),
+                "spring.datasource.username=" + DATABASE_USER, "spring.datasource.password=" + DATABASE_PASSWORD,
+                "agentteams.scheduler.enabled=true", "agentteams.scheduler.poll-interval-ms=100",
+                "agentteams.nats.enabled=true", "agentteams.nats.url=" + natsUrl(),
+                "agentteams.outbox.relay.enabled=true", "agentteams.outbox.relay.poll-interval-ms=100",
+                "agentteams.storage.enabled=false"};
+    }
+
+    private static String[] gatewayProperties() {
+        return new String[] {"spring.main.web-application-type=none", "spring.datasource.url=" + POSTGRES.getJdbcUrl(),
+                "spring.datasource.username=" + DATABASE_USER, "spring.datasource.password=" + DATABASE_PASSWORD,
+                "spring.flyway.enabled=false", "management.endpoint.health.group.readiness.include=readinessState",
+                "management.endpoint.health.validate-group-membership=false", "agentteams.gateway.grpc.port=0",
+                "agentteams.gateway.nats.enabled=true", "agentteams.gateway.nats.url=" + natsUrl(),
+                "agentteams.gateway.nats.subject=task.events.*",
+                "agentteams.gateway.nats.durable=agent-gateway-task-event-scope-it",
+                "agentteams.gateway.nats.instance-id=task-event-scope-it"};
+    }
+
+    private static String[] commandLineProperties(String[] values) {
+        return java.util.Arrays.stream(values).map(value -> "--" + value).toArray(String[]::new);
+    }
+
+    private static JsonNode postJson(String path, String idempotencyKey, String body) throws Exception {
+        var request = HttpRequest.newBuilder().uri(URI.create("http://127.0.0.1:" + controlPlanePort() + path))
+                .header("Content-Type", "application/json").header("Idempotency-Key", idempotencyKey)
+                .POST(HttpRequest.BodyPublishers.ofString(body)).build();
+        HttpResponse<String> response = HttpClient.newHttpClient().send(request, HttpResponse.BodyHandlers.ofString());
+        assertTrue(response.statusCode() >= 200 && response.statusCode() < 300,
+                "unexpected HTTP " + response.statusCode() + ": " + response.body());
+        return JSON.readTree(response.body());
+    }
+
+    private static void awaitReady(BooleanSupplier ready, String message) {
+        long deadline = System.nanoTime() + Duration.ofSeconds(15).toNanos();
+        while (System.nanoTime() < deadline) {
+            if (ready.getAsBoolean()) return;
+            Thread.yield();
+        }
+        assertTrue(ready.getAsBoolean(), message);
+    }
+
+    private static int controlPlanePort() {
+        return ((WebServerApplicationContext) controlPlane).getWebServer().getPort();
+    }
+
+    private static int gatewayPort() {
+        return gateway.getBean(AgentGatewayGrpcServer.class).port();
+    }
+
+    private static JdbcTemplate jdbc() { return new JdbcTemplate(controlPlane.getBean(DataSource.class)); }
+
+    private static String natsUrl() { return "nats://" + NATS.getHost() + ":" + NATS.getMappedPort(4222); }
+
+    private static byte[] randomBytes(int size) { byte[] value = new byte[size]; RANDOM.nextBytes(value); return value; }
+
+    private static String sha256(byte[] value) throws Exception {
+        return java.util.HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(value));
+    }
+}
