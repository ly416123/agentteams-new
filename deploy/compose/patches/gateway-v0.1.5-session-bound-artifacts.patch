diff --git a/agent-gateway/src/main/java/io/agentteams/gateway/JdbcAttemptCapabilityVerifier.java b/agent-gateway/src/main/java/io/agentteams/gateway/JdbcAttemptCapabilityVerifier.java
new file mode 100644
index 0000000..4b89c52
--- /dev/null
+++ b/agent-gateway/src/main/java/io/agentteams/gateway/JdbcAttemptCapabilityVerifier.java
@@ -0,0 +1,63 @@
+package io.agentteams.gateway;
+
+import io.agentteams.contracts.v1.EventMetadata;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.HexFormat;
+import java.util.UUID;
+import java.util.regex.Pattern;
+import org.springframework.jdbc.core.JdbcTemplate;
+
+/** Validates a slot's short-lived Attempt capability through the narrow database function. */
+public final class JdbcAttemptCapabilityVerifier implements AttemptCapabilityVerifier {
+    private static final Pattern TOKEN = Pattern.compile("cap_[A-Za-z0-9_-]{43}");
+    private static final String SQL = """
+            SELECT public.credential_proxy_gateway_validate_attempt_capability(?, ?, ?, ?, ?, ?)
+            """;
+
+    private final JdbcTemplate jdbc;
+
+    public JdbcAttemptCapabilityVerifier(JdbcTemplate jdbc) {
+        this.jdbc = java.util.Objects.requireNonNull(jdbc, "jdbc");
+    }
+
+    @Override
+    public boolean valid(ConnectionRegistry.ConnectionSnapshot connection, EventMetadata metadata) {
+        if (connection == null || connection.identityKind() != GatewayIdentityKind.WORKER_SLOT) {
+            return false;
+        }
+        try {
+            return valid(UUID.fromString(connection.agentId()), metadata);
+        } catch (IllegalArgumentException malformed) {
+            return false;
+        }
+    }
+
+    @Override
+    public boolean valid(UUID slotId, EventMetadata metadata) {
+        if (slotId == null || metadata == null || !TOKEN.matcher(metadata.getAttemptCapability()).matches()) {
+            return false;
+        }
+        try {
+            UUID agentId = UUID.fromString(metadata.getAgentId());
+            UUID taskId = UUID.fromString(metadata.getTaskId());
+            UUID attemptId = UUID.fromString(metadata.getAttemptId());
+            UUID leaseId = UUID.fromString(metadata.getLeaseId());
+            Boolean authorized = jdbc.queryForObject(SQL, Boolean.class, sha256(metadata.getAttemptCapability()),
+                    slotId, agentId, taskId, attemptId, leaseId);
+            return Boolean.TRUE.equals(authorized);
+        } catch (IllegalArgumentException malformed) {
+            return false;
+        }
+    }
+
+    private static String sha256(String value) {
+        try {
+            return HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256")
+                    .digest(value.getBytes(StandardCharsets.UTF_8)));
+        } catch (NoSuchAlgorithmException impossible) {
+            throw new IllegalStateException("SHA-256 is unavailable", impossible);
+        }
+    }
+}
