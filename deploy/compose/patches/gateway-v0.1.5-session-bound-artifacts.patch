+package io.agentteams.gateway;
+
+/** Distinguishes tenant Agents from tenant-neutral fixed-capacity Worker slots. */
+public enum GatewayIdentityKind {
+    AGENT,
+    WORKER_SLOT;
+
+    public String recipientKey(String id) {
+        return this == AGENT ? id : "worker-slot:" + id;
+    }
+}
