+package io.agentteams.gateway;
+
+import io.agentteams.contracts.v1.EventMetadata;
+import java.util.UUID;
+
+/** Verifies that an execution capability is live and bound to this Gateway slot and event. */
+@FunctionalInterface
+public interface AttemptCapabilityVerifier {
+    boolean valid(ConnectionRegistry.ConnectionSnapshot connection, EventMetadata metadata);
+
+    default boolean valid(UUID slotId, EventMetadata metadata) {
+        return false;
+    }
+
+    static AttemptCapabilityVerifier denyAll() {
+        return (connection, metadata) -> false;
+    }
+}
